{
  "name": "@tishlang/tish-ide-panels",
  "version": "0.2.0",
  "description": "Reusable Lattish IDE panels + full SandboxIde shell for Tish: editor, terminal, web preview, file browser, mini-runner, embeddable sandbox-IDE with open-in-new-window. Pure Tish, zero JS deps.",
  "license": "PIF",
  "private": false,
  "homepage": "https://github.com/tishlang/tish-ide-panels#readme",
  "bugs": {
    "url": "https://github.com/tishlang/tish-ide-panels/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tishlang/tish-ide-panels.git"
  },
  "exports": {
    ".": {
      "tish": "./src/index.tish",
      "default": "./src/index.tish"
    },
    "./standalone-entry": {
      "tish": "./src/standalone-entry.tish",
      "default": "./src/standalone-entry.tish"
    },
    "./panels.css": "./src/panels.css",
    "./highlight": {
      "tish": "./src/highlight/TishHighlight.tish",
      "default": "./src/highlight/TishHighlight.tish"
    }
  },
  "main": "./src/index.tish",
  "directories": {
    "example": "example"
  },
  "files": [
    "src/",
    "README.md",
    "example/"
  ],
  "scripts": {
    "test": "node test/run-tests.mjs"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@tishlang/lattish": "../lattish",
    "@tishlang/tish": "^1.12.0",
    "jsdom": "^29.1.1",
    "semantic-release": "^25.0.3"
  },
  "peerDependencies": {
    "@tishlang/lattish": "*"
  },
  "peerDependenciesMeta": {
    "@tishlang/tish-tailwind": {
      "optional": true
    }
  },
  "tish": {
    "module": "./src/index.tish"
  },
  "publishConfig": {
    "access": "public"
  }
}
